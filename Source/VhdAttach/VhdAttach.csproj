<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VhdAttach</RootNamespace>
    <AssemblyName>VhdStudio</AssemblyName>
    <AssemblyTitle>VHD Studio</AssemblyTitle>
    <Description>Attach, maintain and partition VHD, VHDX and ISO images.</Description>
    <ApplicationIcon>Properties\App.ico</ApplicationIcon>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <StartupObject>VhdAttach.App</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VhdAttach-Service\FileWithOptions.cs" Link="Shared\FileWithOptions.cs" />
    <Compile Include="..\VhdAttach-Service\ServiceSettings.cs" Link="Shared\ServiceSettings.cs" />
    <Compile Include="..\VhdAttach-Service\Volume.cs" Link="Shared\Volume.cs" />
    <Compile Include="..\VhdAttach-Service\Branding.cs" Link="Shared\Branding.cs" />
    <Compile Include="..\VhdAttach-Service\VirtualDiskImage.cs" Link="Shared\VirtualDiskImage.cs" />
    <Compile Include="..\VhdAttach-Service\VhdxHeader.cs" Link="Shared\VhdxHeader.cs" />
    <Compile Include="..\VhdAttach-Service\(Medo)\VirtualDisk [010].cs" Link="(Medo)\VirtualDisk [010].cs" />
    <Compile Remove="Properties\SolutionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VhdAttachTest" Key="" />
  </ItemGroup>

</Project>
