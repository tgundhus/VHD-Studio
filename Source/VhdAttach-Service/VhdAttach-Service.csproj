<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VhdAttachService</RootNamespace>
    <AssemblyName>VhdStudioService</AssemblyName>
    <AssemblyTitle>VHD Studio Service</AssemblyTitle>
    <Description>Handles VHD Studio tasks that require administrator privileges (attach, detach, auto-mount at boot).</Description>
    <ApplicationIcon>Properties\App.ico</ApplicationIcon>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <StartupObject>VhdAttachService.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
